{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity Security Audit Evidence",
  "type": "object",
  "required": [
    "request_id",
    "timestamp",
    "user",
    "application",
    "requested_access",
    "risk",
    "policy_decision",
    "reasons",
    "human_approval",
    "action"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "user": {
      "type": "object",
      "required": [
        "display_name",
        "user_principal_name",
        "department"
      ],
      "properties": {
        "display_name": {
          "type": "string"
        },
        "user_principal_name": {
          "type": "string"
        },
        "department": {
          "type": "string"
        }
      }
    },
    "application": {
      "type": "string"
    },
    "requested_access": {
      "type": "string"
    },
    "risk": {
      "type": "object",
      "required": [
        "level",
        "score"
      ],
      "properties": {
        "level": {
          "type": "string"
        },
        "score": {
          "type": "number"
        }
      }
    },
    "policy_decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "REVIEW",
        "BLOCK"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_recommendation": {
      "type": "object"
    },
    "human_approval": {
      "type": "object",
      "required": [
        "required",
        "approved"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "action": {
      "type": "string"
    }
  }
}